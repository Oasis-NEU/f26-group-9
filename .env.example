# Copy to .env and fill in from Supabase dashboard → Project Settings → API
# Only the anon (public) key goes here — never the service_role key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend secrets go in backend/.env (see backend/.env.example), never here.

# Optional: deployed FastAPI backend, enables "Regenerate summary" in the admin page
VITE_BACKEND_URL=
