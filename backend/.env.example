# Copy to backend/.env. NEVER commit the real file or put these in the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Shared secret the Supabase Database Webhook sends as X-Webhook-Secret
WEBHOOK_SECRET=
# Comma-separated origins allowed to call /admin endpoints from the browser
FRONTEND_ORIGINS=http://localhost:5173
